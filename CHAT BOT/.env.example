# Copy these variables into backend/.env on the target machine.
# Never commit real API keys.
DATABASE_URL=postgresql://user:password@localhost:5432/sale_web_project
OPENROUTER_API_KEY=your_openrouter_key_here
GEMINI_API_KEY=your_gemini_key_here
CHATBOT_HOST=127.0.0.1
CHATBOT_PORT=8010

# Optional: comma-separated fallback override.
# OPENROUTER_MODELS=openai/gpt-oss-20b:free,nvidia/nemotron-nano-9b-v2:free
